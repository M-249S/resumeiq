# ============================================================
# ResumeIQ Backend — Environment Variables
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ============================================================

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string. Example for local Postgres:
# postgresql+psycopg://USER:PASSWORD@localhost:5432/resumeiq
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resumeiq

# --- Auth (required) ---------------------------------------------------
# Long, random secret used to sign JWT access/refresh tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# --- AI Providers (at least one is recommended) -----------------------
# The app tries providers in this order: Gemini -> OpenRouter -> Mock data.
# If none of the keys below are set, the app still runs and returns
# mock analysis/rewrite results instead of calling a real AI provider.

# Used to enable the Gemini provider branch in ai_service.py
GEMINI_API_KEY=

# Used for the OpenRouter-backed provider (also powers the "Gemini" and
# "OpenRouter" service modules, which both call OpenRouter under the hood)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional OpenAI fallback (currently not wired into the main provider
# chain in ai_service.py, reserved for future use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- CORS (required for production) -------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Example: https://app.example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
